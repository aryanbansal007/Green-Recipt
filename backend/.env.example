# ==========================================
# GreenReceipt Backend — Environment Template
# Copy to backend/.env and fill in real values. Never commit the real .env.
# ==========================================

# --- Core ---
NODE_ENV=development
PORT=5001
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/greenreceipt

# Comma-separated list of allowed frontend origins (CORS + cookie/redirect targets)
CLIENT_URL=http://localhost:5173

# --- Auth / JWT ---
# Long random strings. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-secret
REFRESH_TOKEN_SECRET=replace-with-different-strong-random-secret

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Razorpay Payment Gateway ---
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Configured in the Razorpay Dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Email (SendGrid) ---
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
# SMTP fallback (nodemailer) if not using SendGrid
EMAIL_USER=
EMAIL_PASS=

# --- Scheduler ---
# Set to "true" to enable the hourly recurring-bill reminder scheduler
RUN_SCHEDULER=false

# --- Optional hardening / proxy tuning ---
# Force Secure cookies even if HTTPS isn't auto-detected behind a proxy
FORCE_SECURE_COOKIES=false
# Enforce Origin header allow-listing on auth routes (defaults to true in production)
STRICT_ORIGIN_CHECK=false
# Allow requests with no Origin header (non-browser clients) when strict check is on
ALLOW_ORIGINLESS_REQUESTS=false
