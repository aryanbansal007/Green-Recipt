# ==========================================
# GreenReceipt Frontend — Environment Template
# Copy to frontend/.env and fill in real values. Never commit the real .env.
# Vite only exposes variables prefixed with VITE_ to the client.
# ==========================================

# Base URL of the backend API (include the /api suffix)
VITE_API_URL=http://localhost:5001/api

# Google OAuth client ID (same project as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
